{
  "name": "librecodecoop/ansible-docker",
  "description": "Development and test tooling for reusable Ansible roles and PHP helpers",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "amphp/websocket-client": "^2.0",
    "danog/php-rtc-webrtc": "^2.0",
    "infection/infection": "^0.30",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.0",
    "symfony/process": "^7.4",
    "vimeo/psalm": "^6.0"
  },
  "autoload": {
    "psr-4": {"LibreCode\\AnsibleDocker\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"LibreCode\\AnsibleDocker\\Tests\\": "tests/"}
  },
  "scripts": {
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration",
    "test:talk": "phpunit --testsuite Talk",
    "phpstan": "phpstan analyse --configuration phpstan.neon",
    "psalm": "psalm --config psalm.xml --no-cache",
    "phpcs": "phpcs -q",
    "test": ["@test:unit", "@test:integration"],
    "qa": ["@phpcs", "@phpstan", "@psalm", "@test"]
  },
  "config": {"sort-packages": true, "allow-plugins": {"infection/extension-installer": false}}
}
