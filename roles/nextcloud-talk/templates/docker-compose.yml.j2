# Managed by Ansible. Deploy only reviewed images with immutable Janus digests.
networks:
  hpb:
    driver: bridge
{% if talk_reverse_proxy_network | length > 0 %}
  proxy:
    external: true
    name: {{ talk_reverse_proxy_network | to_json }}
{% endif %}

services:
  janus:
    image: {{ janus_image | to_json }}
    command:
      - "--full-trickle"
{% if talk_public_ipv4 | length > 0 %}
      - {{ ('--nat-1-1=' ~ talk_public_ipv4) | to_json }}
{% endif %}
    init: true
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
    ports:
      - {{ ((janus_rtp_port_start | string) ~ '-' ~ (janus_rtp_port_end | string) ~ ':' ~ (janus_rtp_port_start | string) ~ '-' ~ (janus_rtp_port_end | string) ~ '/udp') | to_json }}
    networks:
      - hpb
    volumes:
      - type: bind
        source: ./volumes/janus/config/janus.jcfg
        target: /usr/local/etc/janus/janus.jcfg
        read_only: true
        bind:
          create_host_path: false
      - type: bind
        source: ./volumes/janus/config/janus.transport.websockets.jcfg
        target: /usr/local/etc/janus/janus.transport.websockets.jcfg
        read_only: true
        bind:
          create_host_path: false
      - type: bind
        source: ./volumes/janus/config/janus.eventhandler.wsevh.jcfg
        target: /usr/local/etc/janus/janus.eventhandler.wsevh.jcfg
        read_only: true
        bind:
          create_host_path: false

  nats:
    image: {{ nats_image | to_json }}
    restart: unless-stopped
    networks:
      - hpb

  spreedbackend:
    image: {{ spreed_image | to_json }}
    environment:
      CONFIG: /config/server.conf
{% if talk_reverse_proxy_network | length > 0 %}
      VIRTUAL_HOST: {{ talk_signaling_hostname | to_json }}
      LETSENCRYPT_HOST: {{ talk_signaling_hostname | to_json }}
      LETSENCRYPT_EMAIL: {{ talk_letsencrypt_email | to_json }}
      VIRTUAL_PORT: {{ (talk_signaling_port | string) | to_json }}
{% endif %}
    depends_on:
      - nats
      - janus
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
    networks:
      - hpb
{% if talk_reverse_proxy_network | length > 0 %}
      - proxy
{% endif %}
    volumes:
      - type: bind
        source: ./server.conf
        target: /config/server.conf
        read_only: true
        bind:
          create_host_path: false

{% if talk_manage_coturn | bool %}
  coturn:
    image: {{ talk_coturn_image | to_json }}
    command: ["-c", "/etc/turnserver.conf"]
    restart: unless-stopped
    networks:
      - hpb
    ports:
      - {{ ((talk_coturn_port | string) ~ ':' ~ (talk_coturn_port | string) ~ '/udp') | to_json }}
      - {{ ((talk_coturn_port | string) ~ ':' ~ (talk_coturn_port | string) ~ '/tcp') | to_json }}
      - {{ ((talk_turn_relay_start | string) ~ '-' ~ (talk_turn_relay_end | string) ~ ':' ~ (talk_turn_relay_start | string) ~ '-' ~ (talk_turn_relay_end | string) ~ '/udp') | to_json }}
    volumes:
      - type: bind
        source: ./turnserver.conf
        target: /etc/turnserver.conf
        read_only: true
        bind:
          create_host_path: false
{% endif %}
