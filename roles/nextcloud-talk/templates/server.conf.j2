; Private configuration: supplied only from Ansible Vault, stored with mode 0640.
[http]
listen = 0.0.0.0:{{ talk_signaling_port }}

[app]
debug = false

[sessions]
hashkey = {{ talk_session_hashkey }}
blockkey = {{ talk_session_blockkey }}

[clients]
internalsecret = {{ talk_internal_secret }}

[backend]
backends = {{ talk_backend_id }}
allowall = false
timeout = 20
connectionsperhost = 40

[{{ talk_backend_id }}]
urls = {{ talk_nextcloud_url }}
secret = {{ talk_backend_secret }}

[nats]
url = {{ talk_nats_url }}

[mcu]
type = janus
url = ws://janus:{{ janus_websocket_port }}/
maxstreambitrate = {{ talk_max_stream_bitrate }}
maxscreenbitrate = {{ talk_max_screen_bitrate }}

{% if talk_turn_servers | length > 0 %}
[turn]
apikey = {{ talk_turn_api_key }}
secret = {{ talk_turn_shared_secret }}
servers = {{ talk_turn_servers | join(',') }}
{% endif %}
