# Optional managed Coturn. TLS TURN should use dedicated certificate provisioning.
listening-port={{ talk_coturn_port }}
min-port={{ talk_turn_relay_start }}
max-port={{ talk_turn_relay_end }}
realm={{ talk_turn_realm }}
external-ip={{ talk_public_ipv4 }}
fingerprint
use-auth-secret
static-auth-secret={{ talk_turn_shared_secret }}
no-cli
no-loopback-peers
no-multicast-peers
